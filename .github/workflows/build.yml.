          package com.jarvis.clap

          import kotlin.math.max
          import kotlin.math.min
          import kotlin.math.sqrt

          /**
           * Detecta DUAS palmas a partir de áudio PCM 16 kHz mono, em quadros de 20 ms (320 amostras).
           * Só lê números: não grava, não guarda e não envia áudio.
           *
           * Regras:
           *  - palma = subida brusca de energia acima do ruído de fundo E queda rápida (60 ms depois);
           *    fala é sustentada e não passa nesse teste;
           *  - duas palmas = 2ª entre 180 e 700 ms depois da 1ª;
           *  - se houver uma 3ª palma logo depois (aplauso), cancela.
           *
           * minLevel: energia mínima (0..1) para contar como palma. Menor = mais sensível.
           */
          class ClapDetector(private val minLevel: Float = 0.05f) {
              companion object { const val FRAME = 320 }

              private var floor = 0.01f
              private var prev = 0f
              private var idx = 0
              private var pending = -1
              private var peak = 0f
              private var first = -1
              private var second = -1
              private var lockUntil = -1

              /** Processa 320 amostras a partir de [off]. Retorna true quando as duas palmas foram confirmadas. */
              fun process(s: ShortArray, off: Int): Boolean {
                  var sum = 0.0
                  for (k in off until off + FRAME) {
                      val v = s[k] / 32768.0
                      sum += v * v
                  }
                  val rms = sqrt(sum / FRAME).toFloat()
                  val i = idx++
                  var fire = false

                  if (pending >= 0) {
                      if (i - pending <= 2) peak = max(peak, rms)
                      if (i - pending == 3) {
                          if (rms < 0.4f * peak) onClap(pending, i) else lockUntil = i + 10
                          pending = -1
                      }
                  } else if (i >= lockUntil && rms > max(floor * 5f, minLevel) && rms > prev * 2f) {
                      pending = i
                      peak = rms
                  }

                  if (pending < 0) {
                      val a = if (rms < floor * 3f) 0.02f else 0.002f
                      floor = min(0.05f, max(0.002f, floor + a * (rms - floor)))
                  }

                  if (second >= 0 && i >= second + 23 && i >= lockUntil) {
                      second = -1
                      first = -1
                      lockUntil = i + 25
                      fire = true
                  }
                  prev = rms
                  return fire
              }

              private fun onClap(onset: Int, now: Int) {
                  if (second >= 0) {            // 3ª palma durante a janela de confirmação = aplauso
                      second = -1
                      first = -1
                      lockUntil = now + 75
                      return
                  }
                  if (first >= 0 && onset - first in 9..35) {
                      second = onset
                      return
                  }
                  first = onset
                  lockUntil = now + 5
              }
          }
          JVEOF
          mkdir -p "$(dirname 'app/src/main/java/com/jarvis/clap/Gemini.kt')"
          cat > 'app/src/main/java/com/jarvis/clap/Gemini.kt' <<'JVEOF'
          package com.jarvis.clap

          import org.json.JSONArray
          import org.json.JSONObject
          import java.io.IOException
          import java.net.HttpURLConnection
          import java.net.URL

          /** Cliente mínimo da API do Gemini (chave gratuita do Google AI Studio). Só envia TEXTO. */
          object Gemini {
              private const val SYSTEM =
                  "Você é o JARVIS, um assistente por voz. Responda em português do Brasil, " +
                  "em no máximo duas frases curtas, sem markdown, sem listas e sem emojis. " +
                  "Você só conversa: não consegue controlar o celular nem executar ações. " +
                  "Se não souber algo, diga que não sabe."

              private fun msg(role: String, text: String) = JSONObject()
                  .put("role", role)
                  .put("parts", JSONArray().put(JSONObject().put("text", text)))

              @Throws(IOException::class)
              fun ask(key: String, model: String, history: List<Pair<String, String>>, user: String): String {
                  val contents = JSONArray()
                  for ((u, m) in history.takeLast(6)) {
                      contents.put(msg("user", u))
                      contents.put(msg("model", m))
                  }
                  contents.put(msg("user", user))
                  val body = JSONObject()
                      .put("systemInstruction", JSONObject().put("parts", JSONArray().put(JSONObject().put("text", SYSTEM))))
                      .put("contents", contents)

                  val url = URL("https://generativelanguage.googleapis.com/v1beta/models/$model:generateContent")
                  val c = url.openConnection() as HttpURLConnection
                  try {
                      c.requestMethod = "POST"
                      c.connectTimeout = 10000
                      c.readTimeout = 30000
                      c.doOutput = true
                      c.setRequestProperty("Content-Type", "application/json")
                      c.setRequestProperty("x-goog-api-key", key)
                      c.outputStream.use { it.write(body.toString().toByteArray(Charsets.UTF_8)) }
                      val code = c.responseCode
                      val stream = if (code in 200..299) c.inputStream else c.errorStream
                      val text = stream?.bufferedReader()?.use { it.readText() } ?: ""
                      if (code !in 200..299) {
                          val m = runCatching { JSONObject(text).getJSONObject("error").getString("message") }
                              .getOrDefault("erro HTTP $code")
                          throw IOException(m.take(140))
                      }
                      val parts = JSONObject(text).getJSONArray("candidates").getJSONObject(0)
                          .getJSONObject("content").getJSONArray("parts")
                      val sb = StringBuilder()
                      for (k in 0 until parts.length()) sb.append(parts.getJSONObject(k).optString("text"))
                      val out = sb.toString().trim()
                      if (out.isEmpty()) throw IOException("resposta vazia")
                      return out
                  } finally {
                      c.disconnect()
                  }
              }
          }
          JVEOF
          mkdir -p "$(dirname 'app/src/main/java/com/jarvis/clap/JarvisService.kt')"
          cat > 'app/src/main/java/com/jarvis/clap/JarvisService.kt' <<'JVEOF'
          package com.jarvis.clap

          import android.app.Notification
          import android.app.NotificationChannel
          import android.app.NotificationManager
          import android.app.PendingIntent
          import android.app.Service
          import android.content.Context
          import android.content.Intent
          import android.content.SharedPreferences
          import android.content.pm.ServiceInfo
          import android.media.AudioFormat
          import android.media.AudioRecord
          import android.media.MediaRecorder
          import android.os.Build
          import android.os.Bundle
          import android.os.Handler
          import android.os.IBinder
          import android.os.Looper
          import android.speech.RecognitionListener
          import android.speech.RecognizerIntent
          import android.speech.SpeechRecognizer
          import android.speech.tts.TextToSpeech
          import android.speech.tts.UtteranceProgressListener
          import org.json.JSONObject
          import org.vosk.Model
          import org.vosk.Recognizer
          import org.vosk.android.StorageService
          import java.util.Locale
          import kotlin.concurrent.thread

          /**
           * Serviço em primeiro plano (tipo microfone) que:
           *  1. ouve o microfone com UM único AudioRecord;
           *  2. alimenta o ClapDetector (duas palmas) e o Vosk (palavra "Jarvis", offline);
           *  3. ao ser ativado, SOLTA o microfone, fala "Sim?", escuta o comando (SpeechRecognizer do sistema),
           *     manda o texto ao Gemini e fala a resposta; depois volta a ouvir.
           * Como o microfone é solto durante a conversa, o Jarvis não se ativa com a própria voz.
           */
          class JarvisService : Service() {

              companion object {
                  const val ACTION_START = "com.jarvis.clap.START"
                  const val ACTION_STOP = "com.jarvis.clap.STOP"
                  const val ACTION_STATUS = "com.jarvis.clap.STATUS"
                  const val EXTRA_TEXT = "text"
                  const val PREFS = "jarvis"
                  private const val CHANNEL = "jarvis_listen"
                  private const val NOTIF_ID = 1
                  private val WAKE_WORDS = listOf("jarvis", "jarvas", "garvis", "charvis", "travis", "jar vis")
              }

              private val main = Handler(Looper.getMainLooper())
              @Volatile private var running = false
              private lateinit var prefs: SharedPreferences
              private var tts: TextToSpeech? = null
              private var ttsReady = false
              private val ttsDone = HashMap<String, () -> Unit>()
              private var model: Model? = null
              private var speechRec: SpeechRecognizer? = null
              private val history = mutableListOf<Pair<String, String>>()

              override fun onBind(intent: Intent?): IBinder? = null

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  if (intent?.action == ACTION_STOP) {
                      shutdown()
                      return START_NOT_STICKY
                  }
                  if (running) return START_STICKY
                  running = true
                  prefs = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
                  goForeground("Iniciando…")
                  initTts()
                  if (prefs.getBoolean("voice", true)) {
                      status("Carregando modelo de voz…")
                      StorageService.unpack(this, "model-en-us", "model",
                          { m: Model -> model = m; beginListening() },
                          { e: java.io.IOException ->
                              status("Erro no modelo de voz: ${e.message}")
                              beginListening() // continua só com as palmas
                          })
                  } else {
                      beginListening()
                  }
                  return START_STICKY
              }

              // ---------- notificação / status ----------

              private fun goForeground(text: String) {
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(NotificationChannel(CHANNEL, "Jarvis ouvindo", NotificationManager.IMPORTANCE_LOW))
                  val n = buildNotification(text)
                  if (Build.VERSION.SDK_INT >= 29) startForeground(NOTIF_ID, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
                  else startForeground(NOTIF_ID, n)
              }

              private fun buildNotification(text: String): Notification {
                  val open = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE)
                  val stop = PendingIntent.getService(this, 1,
                      Intent(this, JarvisService::class.java).setAction(ACTION_STOP), PendingIntent.FLAG_IMMUTABLE)
                  return Notification.Builder(this, CHANNEL)
                      .setSmallIcon(android.R.drawable.ic_btn_speak_now)
                      .setContentTitle("Jarvis")
                      .setContentText(text)
                      .setContentIntent(open)
                      .setOngoing(true)
                      .addAction(Notification.Action.Builder(null, "Parar", stop).build())
                      .build()
              }

              private fun status(text: String) {
                  getSystemService(NotificationManager::class.java).notify(NOTIF_ID, buildNotification(text))
                  sendBroadcast(Intent(ACTION_STATUS).setPackage(packageName).putExtra(EXTRA_TEXT, text))
              }

              // ---------- voz de saída ----------

              private fun initTts() {
                  tts = TextToSpeech(this) { st ->
                      if (st == TextToSpeech.SUCCESS) {
                          val t = tts ?: return@TextToSpeech
                          val r = t.setLanguage(Locale("pt", "BR"))
                          if (r == TextToSpeech.LANG_MISSING_DATA || r == TextToSpeech.LANG_NOT_SUPPORTED) t.setLanguage(Locale.getDefault())
                          t.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                              override fun onStart(id: String?) {}
                              override fun onDone(id: String?) { finish(id) }
                              @Deprecated("Deprecated in Java")
                              override fun onError(id: String?) { finish(id) }
                              private fun finish(id: String?) {
                                  val cb = if (id == null) null else synchronized(ttsDone) { ttsDone.remove(id) }
                                  if (cb != null) main.post { cb() }
                              }
                          })
                          ttsReady = true
                      } else status("Falha ao iniciar a voz (TTS)")
                  }
              }

              private fun speak(text: String, then: () -> Unit) {
                  val t = tts
                  if (t == null || !ttsReady) { then(); return }
                  val id = "u" + System.nanoTime()
                  synchronized(ttsDone) { ttsDone[id] = then }
                  t.speak(text.take(3500), TextToSpeech.QUEUE_FLUSH, null, id)
              }

              // ---------- ouvir (palmas + "Jarvis") ----------

              private fun beginListening() {
                  if (!running) return
                  thread(name = "jarvis-listen") { listenLoop() }
              }

              private fun levelFromPrefs(): Float = prefs.getFloat("minLevel", 0.05f)

              private fun listenLoop() {
                  val clapsOn = prefs.getBoolean("claps", true)
                  val m = model
                  val voiceOn = prefs.getBoolean("voice", true) && m != null
                  if (!clapsOn && !voiceOn) { status("Nada ativado: ligue palmas ou voz"); return }

                  val sr = 16000
                  val chunk = 1280 // 80 ms = 4 quadros de 20 ms
                  val minBuf = AudioRecord.getMinBufferSize(sr, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
                  val rec = try {
                      AudioRecord(MediaRecorder.AudioSource.MIC, sr, AudioFormat.CHANNEL_IN_MONO,
                          AudioFormat.ENCODING_PCM_16BIT, maxOf(minBuf, chunk * 4))
                  } catch (e: Exception) { null }
                  if (rec == null || rec.state != AudioRecord.STATE_INITIALIZED) {
                      status("Microfone indisponível. Tentando de novo…")
                      rec?.release()
                      retryLater()
                      return
                  }
                  val clap = Cla
